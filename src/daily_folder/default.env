# ── IMPRESOS ───────────────────────────────────────────────────────────────
# Copiar a `.env` en la raíz del proyecto (o junto al ejecutable) y ajustar
# según el entorno de producción.
#
#   cp src/impresos/default.env .env
#
# Estos valores pueden sobrescribirse desde la línea de comandos.

# ---------------------------------------------------------------------------
# Modos administrativos (una sola ejecución)
# ---------------------------------------------------------------------------

# Fecha única a procesar (YYYY-MM-DD). El programa sale tras procesarla.
# IMPRESOS_DATE=2025-03-07

# Rango de backfill — inicio (YYYY-MM-DD). Usar junto con IMPRESOS_END.
# IMPRESOS_START=2025-03-01

# Rango de backfill — fin (YYYY-MM-DD). Usar junto con IMPRESOS_START.
# IMPRESOS_END=2025-03-31

# ---------------------------------------------------------------------------
# Modo continuo
# ---------------------------------------------------------------------------

# Procesa el día actual una sola vez y sale (útil para cron / Task Scheduler).
# IMPRESOS_ONCE=true

# Segundos entre chequeos sucesivos en modo continuo.
# IMPRESOS_INTERVAL=300

# ---------------------------------------------------------------------------
# Configuración general
# ---------------------------------------------------------------------------

# Directorio raíz donde se crea la estructura YYYY/MM MES/DD
IMPRESOS_ROOT_DIRECTORY=D:/ftp

# Ruta al archivo .toml de configuración
# IMPRESOS_SETTINGS_FILE=./.settings/impresos.toml
