# ── PRINTED ───────────────────────────────────────────────────────────────
# Copy to `.env` at the project root (or next to the executable) and adjust
# according to the production environment.
#
#   cp src/daifo/default.env .env
#
# These values can be overridden from the command line.

# ---------------------------------------------------------------------------
# Administrative modes (single run)
# ---------------------------------------------------------------------------

# Single date to process (YYYY-MM-DD). The program exits after processing it.
# PRINTED_DATE=2025-03-07

# Backfill range — start (YYYY-MM-DD). Use together with PRINTED_END.
# PRINTED_START=2025-03-01

# Backfill range — end (YYYY-MM-DD). Use together with PRINTED_START.
# PRINTED_END=2025-03-31

# ---------------------------------------------------------------------------
# Continuous mode
# ---------------------------------------------------------------------------

# Process the current day once and exit (useful for cron / Task Scheduler).
# PRINTED_ONCE=true

# Seconds between successive checks in continuous mode.
# PRINTED_INTERVAL=300

# ---------------------------------------------------------------------------
# General configuration
# ---------------------------------------------------------------------------

# Root directory where the YYYY/MM MONTH/DD structure is created
PRINTED_ROOT_DIRECTORY=D:/ftp

# Path to the .toml configuration file
# PRINTED_SETTINGS_FILE=./.settings/daifo.toml


# Disable Color Eyre coloring for better readability in logs (set to "true" to disable coloring)
# NO_COLOR=true
